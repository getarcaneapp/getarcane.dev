{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getarcane-dev",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "getarcane.dev",
      "custom_domain": true,
    },
    {
      "pattern": "go.getarcane.app",
      "custom_domain": true,
    },
    {
      "pattern": "kit.getarcane.app",
      "custom_domain": true,
    },
  ],
}
