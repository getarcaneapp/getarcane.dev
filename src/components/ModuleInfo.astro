---
import { Code } from '@astrojs/starlight/components';
import { getPackage } from '../data/modules';

interface Props {
	/** Full import path, e.g. "kit.getarcane.app/docker/compat". */
	path: string;
}

const pkg = getPackage(Astro.props.path);
---

<dl class="module-info not-content">
	{
		pkg.path !== pkg.module && (
			<div>
				<dt>Package</dt>
				<dd><code>{pkg.path}</code></dd>
			</div>
		)
	}
	<div>
		<dt>Module</dt>
		<dd><code>{pkg.module}</code></dd>
	</div>
	<div>
		<dt>Source</dt>
		<dd><a href={pkg.source}>{pkg.source.replace('https://', '')}</a></dd>
	</div>
	<div>
		<dt>Reference</dt>
		<dd><a href={`https://pkg.go.dev/${pkg.path}`}>pkg.go.dev</a></dd>
	</div>
</dl>

<Code code={`go get ${pkg.module}@latest`} lang="sh" />

<style>
	.module-info {
		display: grid;
		gap: 0.5rem;
		margin-block: 1.5rem 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--radius);
		font-size: var(--sl-text-sm);
	}

	.module-info > div {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 1rem;
	}

	.module-info dt {
		color: var(--sl-color-gray-3);
	}

	.module-info dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
</style>
